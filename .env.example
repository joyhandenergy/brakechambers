# Sanity CMS Public Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Write / Management Token (Required for content sync scripts)
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.brakechambers.com

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@brakechambers.com
SMTP_PASS=your_smtp_password
SALES_EMAIL=sales@brakechambers.com
