# Sanity CMS Public Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Write / Management Token (Required for content sync scripts)
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.brakechambers.com

# Resend Configuration (Transactional Mailer for Cloudflare Edge)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="BRC Website Lead <sales@brakechambers.com>"

# Lead Notification Inboxes
SALES_EMAIL=sales@brakechambers.com, brcbrakechambers@gmail.com

